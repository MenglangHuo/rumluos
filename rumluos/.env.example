# ==============================================================================
# Rumluos App Environment Variables (Example)
# ==============================================================================
# Copy this file to .env and replace the values with your actual configuration.

# -- App Settings --
APP_VERSION=latest
APP_PREFIX=rumluos
APP_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# -- PostgreSQL Settings --
POSTGRES_DB=rumluos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_HOST_PORT=54326

# -- Security / JWT Settings --
# Add your JWT secrets and other sensitive keys below
# JWT_SECRET_KEY=your_super_secret_key_here
