COMPOSE_PROJECT_NAME=rumluos
APP_VERSION=0.1.0
POSTGRES_DB=rumluos_db
POSTGRES_USER=rumluos
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public hostname. Replace before enabling HTTPS in nginx.
DOMAIN=example.com

# Backend
JWT_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
JWT_PUBLIC_KEY=replace-with-base64-x509-public-key
AWS_S3_BUCKET=replace-with-private-s3-bucket
AWS_S3_PUBLIC_BUCKET_NAME=
AWS_S3_REGION=ap-southeast-1

# Frontend server action -> backend container
API_INTERNAL_URL=http://backend:8080/api/v1
