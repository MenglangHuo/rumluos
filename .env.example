COMPOSE_PROJECT_NAME=rumluos
APP_VERSION=0.1.0
# Database configuration
# For local Docker Compose, keep POSTGRES_HOST=postgres and POSTGRES_PORT=5432.
# For AWS deployment with RDS, set POSTGRES_HOST to your RDS endpoint (e.g. from terraform output db_endpoint).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=rumluos_db
POSTGRES_USER=rumluos
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Public hostname. Replace before enabling HTTPS in nginx.
DOMAIN=example.com

# Backend
JWT_PRIVATE_KEY=replace-with-base64-pkcs8-private-key
JWT_PUBLIC_KEY=replace-with-base64-x509-public-key
AWS_S3_BUCKET=replace-with-private-s3-bucket
AWS_S3_PUBLIC_BUCKET_NAME=
AWS_S3_REGION=ap-southeast-1

# Frontend server action -> backend container
API_INTERNAL_URL=http://backend:8080/api/v1

# Optional Grafana Cloud / OpenTelemetry configuration.
# Keep telemetry disabled until these values are configured.
OTEL_SERVICE_NAME=rumluos-backend
OTEL_SDK_DISABLED=false
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_ENABLED=false
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_METRIC_EXPORT_INTERVAL=PT1M

# Copy these from Grafana Cloud -> Connections -> OpenTelemetry.
# GRAFANA_OTLP_URL should be the OTLP base endpoint, usually ending in /otlp.
GRAFANA_OTLP_URL=
# Use the value portion of the Authorization header only.
# Example: "Basic base64(username:token)"
GRAFANA_OTLP_AUTH=
# Optional override if your Grafana metrics endpoint differs from the base URL.
GRAFANA_OTLP_METRICS_URL=
